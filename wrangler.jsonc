{
  // Portal confidencial Pina — Cloudflare Workers (plano gratuito)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pina-portal",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Sem "id": o namespace KV é criado automaticamente no primeiro deploy.
  "kv_namespaces": [{ "binding": "STORE" }],
  "observability": { "enabled": true }
  // Segredos (configurar no painel da Cloudflare, tipo "Secret"):
  //   ADMIN_PASSWORD  – sua senha do painel /admin
  //   NOTIFY_EMAIL    – e-mail que recebe os avisos de acesso
  //   RESEND_API_KEY  – chave gratuita do resend.com para enviar os e-mails
  //   PROXYCHECK_KEY  – (opcional) chave gratuita do proxycheck.io p/ detectar VPN
}
